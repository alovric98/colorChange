# Kopiraj u .env.local i popuni. Nikad ne commitaj prave vrijednosti.

# Anthropic (Claude API) – https://console.anthropic.com
ANTHROPIC_API_KEY=

# API-Football (api-sports.io) – https://dashboard.api-football.com
API_FOOTBALL_KEY=

# Neon Postgres connection string (s ?sslmode=require)
DATABASE_URL=

# Dugi nasumični token; Vercel Cron ga šalje kao "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Lozinka za gumbe "Analiziraj ovu ligu" / "Osvježi analizu"
APP_PASSWORD=

# Opcionalno: javni URL aplikacije (za nastavak pozadinskih poslova).
# Na Vercelu se automatski koristi VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
APP_URL=
